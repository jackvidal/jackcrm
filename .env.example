# Written by `npx convex dev` for local development.
CONVEX_DEPLOYMENT=dev:YOUR_DEV_DEPLOYMENT
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEV_DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR_DEV_DEPLOYMENT.convex.site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generated by scripts/configure-convex-auth.mjs. Server-only; never NEXT_PUBLIC.
CRM_AUTH_PRIVATE_KEY=

# AI providers (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

# Match the webhook providers' configured signing/shared secrets.
CAL_WEBHOOK_SECRET=
WASSENDER_WEBHOOK_SECRET=
# WASSENDER_API_URL=https://wasenderapi.com/api

# Convex deployment variables are set by the configuration scripts:
# CRM_AUTH_JWKS, JWT_PRIVATE_KEY, JWKS, SITE_URL
